/**
 * vitest-pool-workers 専用の wrangler 設定。
 *
 * なぜ分離するか: vitest-pool-workers(workerd)はローカルで Container を起動できないため、
 * 次 Issue(P3-4)で wrangler.jsonc に追加する `containers` / DemoContainer は **ここには含めない**。
 * DO(Counter/ChatRoom/RateLimiter/AlarmClock)はローカル実行可能なので、テストに必要な
 * bindings と migrations のみをここに保持する。P3-3 時点では本番 wrangler.jsonc と同内容。
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-stack-lab-demos",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:8787"
  },
  "durable_objects": {
    "bindings": [
      { "name": "COUNTER", "class_name": "Counter" },
      { "name": "CHAT_ROOM", "class_name": "ChatRoom" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
      { "name": "ALARM_CLOCK", "class_name": "AlarmClock" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Counter", "ChatRoom", "RateLimiter", "AlarmClock"]
    }
  ]
}
