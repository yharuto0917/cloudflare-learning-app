/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * NOTE: KV / R2 / D1 / Flagship の id・bucket_name・database_id・app_id は
 * すべてプレースホルダ。ローカル(miniflare)検証はバインディング名で動くため値の中身を問わない。
 * 実リソース作成と実IDの差し込みは P3-5(Issue #20)で行う。実シークレットはここに置かない。
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-stack-lab",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-06-11",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "cf-stack-lab"
		},
		{
			// デモ用 Hono Worker(workers/demos)への Service Binding
			"binding": "DEMOS",
			"service": "cf-stack-lab-demos"
		}
	],
	"kv_namespaces": [
		{
			// デモ用 KV(プレースホルダID)
			"binding": "DEMO_KV",
			"id": "placeholder-demo-kv"
		}
	],
	"r2_buckets": [
		{
			// OpenNext 増分キャッシュ用(独自 prefix)
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "cf-stack-lab"
		},
		{
			// デモ用(同一バケット、demo/ prefix 運用)
			"binding": "DEMO_BUCKET",
			"bucket_name": "cf-stack-lab"
		}
	],
	"d1_databases": [
		{
			// アプリ用 D1(Drizzle migrations は drizzle/ に出力)
			"binding": "DB",
			"database_name": "cf-stack-lab",
			"database_id": "placeholder-d1-database",
			"migrations_dir": "drizzle"
		},
		{
			// OpenNext タグキャッシュ用(同一 DB)
			"binding": "NEXT_TAG_CACHE_D1",
			"database_name": "cf-stack-lab",
			"database_id": "placeholder-d1-database"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				// OpenNext のキャッシュ書き戻しキュー(生成 worker が DOQueueHandler を export)
				"name": "NEXT_CACHE_DO_QUEUE",
				"class_name": "DOQueueHandler"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"DOQueueHandler"
			]
		}
	],
	/**
	 * Flagship binding(FLAGS)は P3-1 スパイクの結果、ここでは宣言しない。
	 * 理由: Flagship binding は「常に remote」のため、`next dev` がプレースホルダ app_id で
	 *       remote proxy セッションを張ろうとして失敗し(Flagship app not found / code 10364)、
	 *       dev 起動自体が阻害される。実 Flagship アプリ(実 app_id)が用意できる P3-5 で宣言する。
	 * 当面はコード側の src/lib/flags.ts が env.FLAGS 未定義時にデフォルト値へフォールバックする。
	 */
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
}
